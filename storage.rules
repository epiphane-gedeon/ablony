rules_version = '2';

// Firebase Storage Security Rules pour Ablony
service firebase.storage {
  match /b/{bucket}/o {
    
    // ============================================================
    // FONCTIONS UTILITAIRES
    // ============================================================
    
    /// Vérifie si l'utilisateur est authentifié
    function isAuthenticated() {
      return request.auth != null;
    }
    
    /// Vérifie si l'utilisateur est le propriétaire
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    /// Vérifie si le fichier est une image
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    /// Vérifie la taille du fichier (max 5MB)
    function isValidSize() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // ============================================================
    // IMAGES DE PRODUITS
    // ============================================================
    // Structure : products/{userId}/{productId}/image_{0-5}.jpg
    match /products/{userId}/{productId}/{imageFile} {
      // Lecture : Accessible à tous (images publiques)
      allow read: if true;
      
      // Écriture : Uniquement le propriétaire
      // Vérifie que c'est une image et que la taille est valide
      allow write: if isOwner(userId)
        && isImage()
        && isValidSize()
        && imageFile.matches('image_[0-5]\\.(jpg|jpeg|png|webp)');
      
      // Suppression : Uniquement le propriétaire
      allow delete: if isOwner(userId);
    }
    
    // ============================================================
    // PHOTOS DE PROFIL
    // ============================================================
    // Structure : users/{userId}/profile.jpg (ou .png, .webp, etc.)
    match /users/{userId}/{fileName} {
      // Lecture : Accessible à tous
      allow read: if true;
      
      // Écriture : Uniquement le propriétaire pour les photos de profil
      allow write: if isOwner(userId)
        && fileName.matches('profile\\.(jpg|jpeg|png|webp)')
        && isImage()
        && isValidSize();
      
      // Suppression : Uniquement le propriétaire
      allow delete: if isOwner(userId);
    }
    
    // ============================================================
    // PHOTOS DE CHAT
    // ============================================================
    // Structure : chat_images/{conversationId}/{senderId}/{timestamp}.jpg
    //
    // Storage Rules ne peuvent pas référencer les données Firestore (pas de
    // lookup croisé "est-il participant de cette conversation ?"), donc la
    // vérification se fait uniquement via le chemin, comme pour products/ et
    // users/ ci-dessus. Lecture ouverte aux utilisateurs authentifiés (comme
    // partout ailleurs dans ce fichier, les URLs de téléchargement portent de
    // toute façon un token d'accès non devinable) ; écriture/suppression
    // strictement réservées à l'expéditeur du fichier.
    match /chat_images/{conversationId}/{senderId}/{fileName} {
      allow read: if isAuthenticated();

      allow write: if isOwner(senderId)
        && isImage()
        && isValidSize();

      allow delete: if isOwner(senderId);
    }

    // ============================================================
    // PIÈCES JOINTES D'ASSISTANCE
    // ============================================================
    // Structure : support/{userId}/{fichier}
    //
    // Une capture de débit vaut mieux qu'une description : c'est elle qui
    // permet de trancher vite quand quelqu'un dit avoir payé sans contrepartie.
    match /support/{userId}/{fileName} {
      // Lecture réservée à l'intéressé ; l'équipe passe par l'Admin SDK, qui
      // ne dépend pas de ces règles.
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isImage() && isValidSize();
      allow delete: if false;
    }

    // ============================================================
    // PHOTOS DE LITIGE
    // ============================================================
    // Une description seule ne permet de trancher ni dans un sens ni dans
    // l'autre : ces photos sont la matière de la décision.
    //
    // L'identifiant de qui dépose est **dans le chemin**, comme pour les
    // images de discussion. L'alternative — relire la transaction Firestore
    // depuis ces règles — coûterait une lecture à chaque accès et lierait le
    // dépôt d'une photo à la disponibilité d'une autre collection. Ce qui
    // protège réellement, c'est `openDispute` : une photo déposée par qui
    // n'est pas partie à la vente n'entre dans aucun dossier.
    match /disputes/{transactionRef}/{userId}/{fileName} {
      allow read: if isAuthenticated();

      allow write: if isOwner(userId)
        && isImage()
        && isValidSize();

      // Jamais de suppression : une pièce du dossier ne s'efface pas une fois
      // le litige ouvert, surtout par celui qu'elle accuse.
      allow delete: if false;
    }

    // ============================================================
    // RÈGLE PAR DÉFAUT : TOUT REFUSER
    // ============================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
