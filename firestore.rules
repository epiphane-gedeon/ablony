rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================
    // FONCTIONS UTILITAIRES
    // ============================================================
    
    /// Vérifie si l'utilisateur est authentifié
    function isAuthenticated() {
      return request.auth != null;
    }
    
    /// Vérifie si l'utilisateur est le propriétaire de la ressource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    /// Vérifie si l'utilisateur a un profil complet
    function hasCompleteProfile() {
      return isAuthenticated() 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.country != null;
    }
    
    // ============================================================
    // COLLECTION : users
    // ============================================================
    // Gère les profils utilisateurs
    match /users/{userId} {
      // Lecture : Tout le monde peut voir les profils publics
      allow read: if true;
      
      // Création : Uniquement l'utilisateur authentifié peut créer son propre profil
      // Vérifie que l'UID correspond et que les champs obligatoires sont présents
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['uid', 'email', 'username', 'authProvider', 'country'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 30
        && request.resource.data.acceptedTerms == true;
      
      // Mise à jour :
      // 1) le propriétaire peut modifier son profil (champs sensibles protégés)
      // 2) tout utilisateur authentifié peut uniquement incrémenter/décrémenter
      //    followersCount de 1 (lorsqu'il suit/ne suit plus ce profil)
      allow update: if (
          isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.authProvider == resource.data.authProvider
          && request.resource.data.createdAt == resource.data.createdAt
          // Validation du wallet si présent
          && (!request.resource.data.keys().hasAny(['wallet'])
            || (request.resource.data.wallet is map
              && request.resource.data.wallet.keys().hasAll(['firstName', 'lastName', 'nationality', 'birthDate', 'availableAmount', 'pendingAmount', 'isActivated'])
              && request.resource.data.wallet.firstName is string
              && request.resource.data.wallet.lastName is string
              && request.resource.data.wallet.nationality is string
              && request.resource.data.wallet.availableAmount is int
              && request.resource.data.wallet.pendingAmount is int
              && request.resource.data.wallet.isActivated is bool
              // Une fois activé, le wallet ne peut pas être désactivé
              && (!resource.data.keys().hasAny(['wallet'])
                || !resource.data.wallet.isActivated
                || request.resource.data.wallet.isActivated == true)
            ))
        ) || (
          isAuthenticated()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['followersCount'])
          && request.resource.data.followersCount is int
          && request.resource.data.followersCount >= 0
          && (
            // Cas 1 : le compte n'a pas encore de followersCount (compte créé avant
            // cette fonctionnalité) → le premier abonné doit l'initialiser à 1
            (!resource.data.keys().hasAny(['followersCount']) && request.resource.data.followersCount == 1)
            // Cas 2 : le champ existe déjà → on ne peut le déplacer que de ±1
            || (resource.data.followersCount is int
              && (
                request.resource.data.followersCount == resource.data.followersCount + 1
                || request.resource.data.followersCount == resource.data.followersCount - 1
              ))
          )
        );

      // Suppression : Uniquement le propriétaire (et dans le futur, les admins)
      allow delete: if isOwner(userId);

    }

    // ============================================================
    // COLLECTION : notifications
    // ============================================================
    // Notifications in-app, entièrement générées par les Cloud Functions
    // (Admin SDK, contourne ces règles). Le client ne peut que lire les
    // siennes et les marquer comme lues.
    match /notifications/{notificationId} {
      // Lecture : uniquement le destinataire
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Création : réservée aux Cloud Functions (Admin SDK, hors règles)
      allow create: if false;

      // Mise à jour : le destinataire peut uniquement marquer comme lu/non lu
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;

      // Suppression : le destinataire peut supprimer sa propre notification
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ============================================================
    // COLLECTION : receipts
    // ============================================================
    // Reçus d'achat, entièrement générés par les Cloud Functions (Admin SDK).
    // Lecture réservée à l'acheteur et au vendeur concernés.
    match /receipts/{receiptId} {
      allow read: if isAuthenticated()
        && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);

      allow create, update, delete: if false;
    }

    // ============================================================
    // COLLECTION : qrcodes
    // ============================================================
    // Relie l'id opaque encodé dans le QR de remise en main propre à la
    // transaction réelle (transactionRef, sellerId, buyerId). Entièrement
    // généré et lu par les Cloud Functions (Admin SDK) : le client ne
    // manipule jamais que l'id du document, jamais son contenu directement.
    match /qrcodes/{qrCodeId} {
      allow read, write: if false;
    }

    // ============================================================
    // COLLECTION : reviews
    // ============================================================
    // Avis laissés par un acheteur sur un vendeur, un seul par transaction
    // complétée. L'id du document = référence de la transaction : ça
    // garantit l'unicité (un 2e essai d'écriture tombe sous "update",
    // interdit ci-dessous) et permet de vérifier l'achat réel via `get()`.
    match /reviews/{reviewId} {
      // Lecture : publique (affichée sur le profil du vendeur)
      allow read: if true;

      // Création : uniquement l'acheteur, pour un achat réellement complété
      // et correspondant (même vendeur, même produit, même acheteur).
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['buyerId', 'sellerId', 'productId', 'rating', 'transactionRef', 'createdAt'])
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.transactionRef == reviewId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && exists(/databases/$(database)/documents/transactions/$(reviewId))
        && get(/databases/$(database)/documents/transactions/$(reviewId)).data.status == 'completed'
        && get(/databases/$(database)/documents/transactions/$(reviewId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/transactions/$(reviewId)).data.sellerId == request.resource.data.sellerId
        && get(/databases/$(database)/documents/transactions/$(reviewId)).data.productId == request.resource.data.productId;

      // Mise à jour / suppression : jamais (avis immuable)
      allow update, delete: if false;
    }

    // ============================================================
    // COLLECTION : reports
    // ============================================================
    // Signalements d'articles par les utilisateurs (contrefaçon, contenu
    // inapproprié, arnaque...). Aucune lecture côté client : uniquement
    // consultés côté modération via la console/Admin SDK.
    match /reports/{reportId} {
      allow read: if false;

      // Création : uniquement l'auteur du signalement, jamais sur son propre article
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['productId', 'sellerId', 'reporterId', 'reason', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.reason is string;

      // Mise à jour / suppression : jamais (signalement immuable)
      allow update, delete: if false;
    }

    // ============================================================
    // COLLECTION : follows
    // ============================================================
    // Relation d'abonnement : un document par paire (followerId, followedId)
    match /follows/{followId} {
      // Lecture : publique (listes d'abonnés/abonnements visibles sur les profils)
      allow read: if true;

      // Création : uniquement pour soi-même, on ne peut pas se suivre soi-même
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['followerId', 'followedId', 'createdAt'])
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followedId is string
        && request.resource.data.followedId != request.auth.uid;

      // Mise à jour : non autorisée (toggle = create/delete)
      allow update: if false;

      // Suppression : uniquement celui qui suit peut se désabonner
      allow delete: if isAuthenticated() && resource.data.followerId == request.auth.uid;
    }

    // ============================================================
    // COLLECTION : fav
    // ============================================================
    // Relation favoris : un document par paire (userId, productId)
    match /fav/{favId} {
      // Lecture : autorisée pour utilisateur connecté
      // (nécessaire pour les lectures transactionnelles sur doc potentiellement absent)
      allow read: if isAuthenticated();

      // Création : uniquement pour soi-même
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['productId', 'userId', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId is string;

      // Mise à jour : non autorisée (toggle = create/delete)
      allow update: if false;

      // Suppression : uniquement le propriétaire du favori
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ============================================================
    // COLLECTION : usernames
    // ============================================================
    // Gère la réservation des noms d'utilisateur (unicité)
    match /usernames/{username} {
      // Lecture : Accessible à tous pour vérifier la disponibilité
      allow read: if true;
      
      // Création : Uniquement lors de la création du profil utilisateur
      // Vérifie que le username correspond à celui du profil
      // Note: On ne vérifie PAS l'existence de users/{uid} car la création se fait en transaction
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      
      // Mise à jour : Impossible (les usernames ne changent pas après création)
      // Note : Pour changer de username, il faut supprimer l'ancien et créer un nouveau
      allow update: if false;
      
      // Suppression : Uniquement le propriétaire (pour changer de username)
      allow delete: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
    }
    
    // ============================================================
    // COLLECTION : relayPoints
    // ============================================================
    // Points relais pour la livraison (choix à l'étape paiement).
    // Lecture publique, écriture admin uniquement (gérés côté backend).
    match /relayPoints/{relayPointId} {
      allow read: if true;
      allow write: if false;
    }

    // ============================================================
    // COLLECTION : config (categories, subcategories, attributes)
    // ============================================================
    // Configuration des catégories et attributs produits
    // Lecture publique, écriture admin uniquement
    match /config/{document=**} {
      // Lecture : Accessible à tous pour afficher les catégories
      allow read: if true;
      
      // Écriture : Réservé aux admins (à implémenter avec custom claims)
      // Pour l'instant, on bloque toute écriture (gestion via console Firebase)
      allow write: if false;
    }
    
    // ============================================================
    // COLLECTION : products
    // ============================================================
    // Gère les produits mis en vente
    match /products/{productId} {
      // Lecture : Tout le monde peut voir les produits actifs
      allow read: if true;
      
      // Création : Utilisateur authentifié avec profil complet
      // Vérifie que le vendeur est bien l'utilisateur connecté
      allow create: if hasCompleteProfile()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.keys().hasAll(['title', 'description', 'price', 'imageUrls', 'condition', 'categoryId', 'subcategoryId'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 100
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.imageUrls is list
        && request.resource.data.imageUrls.size() >= 1
        && request.resource.data.imageUrls.size() <= 6;
      
      // Mise à jour :
      // 1) le vendeur peut modifier son produit (mais jamais isBoosted/boostExpiresAt
      //    directement : le boost est payant, seule la Cloud Function finalizeBoost
      //    — via l'Admin SDK, qui contourne ces règles — peut les modifier)
      // 2) tout utilisateur authentifié peut uniquement incrémenter/décrémenter favoritesCount de 1
      allow update: if (
          isOwner(resource.data.sellerId)
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get('isBoosted', false) == resource.data.get('isBoosted', false)
          && request.resource.data.get('boostExpiresAt', null) == resource.data.get('boostExpiresAt', null)
        ) || (
          isAuthenticated()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['favoritesCount'])
          && resource.data.favoritesCount is int
          && request.resource.data.favoritesCount is int
          && request.resource.data.favoritesCount >= 0
          && (
            request.resource.data.favoritesCount == resource.data.favoritesCount + 1
            || request.resource.data.favoritesCount == resource.data.favoritesCount - 1
          )
        );
      
      // Suppression : Uniquement le vendeur
      allow delete: if isOwner(resource.data.sellerId);
    }
    
    // ============================================================
    // COLLECTION : conversations
    // ============================================================
    // Gère les conversations entre acheteurs et vendeurs
    match /conversations/{conversationId} {
      // Lecture : Uniquement les participants de la conversation
      allow read: if isAuthenticated() 
        && request.auth.uid in resource.data.participants;
      
      // Création : Utilisateur authentifié qui est l'un des participants
      allow create: if isAuthenticated() 
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && request.resource.data.keys().hasAll(['participants', 'participantDetails', 'productId', 'productDetails', 'unreadCount', 'createdAt', 'updatedAt']);
      
      // Mise à jour : Les participants peuvent mettre à jour (lastMessage, unreadCount, etc.)
      allow update: if isAuthenticated() 
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.productId == resource.data.productId;
      
      // Sous-collection : messages
      match /messages/{messageId} {
        // Lecture : Uniquement les participants de la conversation
        allow read: if isAuthenticated() 
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        
        // Création : Uniquement les participants peuvent envoyer des messages
        allow create: if isAuthenticated() 
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasAll(['senderId', 'type', 'timestamp', 'read']);
        
        // Mise à jour : Pour marquer comme lu ou modifier le statut d'une offre
        allow update: if isAuthenticated() 
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        
        // Suppression : Aucune suppression de messages
        allow delete: if false;
      }
    }
    
    // ============================================================
    // RÈGLE PAR DÉFAUT : TOUT REFUSER
    // ============================================================
    // Toute collection non définie est interdite
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
